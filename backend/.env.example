# =============================================================================
# SmartCinema Backend Environment Variables
# =============================================================================

# Server Port (Default: 5000)
PORT=5000

# Flask Secret Key
SECRET_KEY=smartcinema_secret_change_me_in_production

# TMDb API Key (Optional, for metadata fetching)
# Get your free key at: https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Ollama / Local AI Host (Default: http://localhost:11434)
OLLAMA_HOST=http://localhost:11434

# CORS Allowed Origins (Comma-separated, or * for all)
CORS_ORIGINS=*
